import json
from decimal import Decimal


def D(value):
    if value is None:
        return Decimal("0")
    return Decimal(str(value))


def fmt(value):
    if isinstance(value, Decimal):
        if value == value.to_integral():
            return str(value.quantize(Decimal("1")))
        return format(value.normalize(), "f")
    return str(value)


def load_json(input_json):
    if isinstance(input_json, str):
        return json.loads(
            input_json,
            parse_float=Decimal,
            parse_int=Decimal
        )

    if isinstance(input_json, dict):
        return input_json

    raise ValueError(
        "Input must be a JSON string or Python dictionary."
    )


def compare_jsons(json1, json2):
    data1 = load_json(json1)
    data2 = load_json(json2)

    # تمام فیلدهای موجود در هر دو JSON
    # بدون حذف فیلدهای تکراری
    all_fields = list(
        dict.fromkeys(
            list(data1.keys()) + list(data2.keys())
        )
    )

    results = {}

    for field in all_fields:

        # اگر فیلد فقط در JSON 2 باشد
        if field not in data1:
            results[field] = {
                "Json1": "Field Not Found",
                "Json2": data2.get(field),
                "Difference": "N/A"
            }
            continue

        # اگر فیلد فقط در JSON 1 باشد
        if field not in data2:
            results[field] = {
                "Json1": data1.get(field),
                "Json2": "Field Not Found",
                "Difference": "N/A"
            }
            continue

        value1 = data1[field]
        value2 = data2[field]

        is_numeric_1 = isinstance(
            value1,
            (int, float, Decimal)
        )

        is_numeric_2 = isinstance(
            value2,
            (int, float, Decimal)
        )

        # اگر هر دو مقدار عددی باشند
        if is_numeric_1 and is_numeric_2:
            value1 = D(value1)
            value2 = D(value2)

            results[field] = {
                "Json1": value1,
                "Json2": value2,

                # Difference = JSON 2 - JSON 1
                "Difference": value2 - value1
            }

        # برای مقادیر غیرعددی مثل AccountNumber
        else:
            results[field] = {
                "Json1": value1,
                "Json2": value2,
                "Difference": (
                    "Same"
                    if value1 == value2
                    else "Different"
                )
            }

    return results


def print_comparison_table(results):
    field_width = 32
    value_width = 24
    diff_width = 24

    separator = (
        "+"
        + "-" * (field_width + 2)
        + "+"
        + "-" * (value_width + 2)
        + "+"
        + "-" * (value_width + 2)
        + "+"
        + "-" * (diff_width + 2)
        + "+"
    )

    print()
    print("=" * 115)
    print("JSON COMPARISON")
    print("Difference = JSON 2 - JSON 1")
    print("=" * 115)
    print()

    print(separator)

    print(
        f"| {'Field':<{field_width}} "
        f"| {'JSON 1':>{value_width}} "
        f"| {'JSON 2':>{value_width}} "
        f"| {'Difference':>{diff_width}} |"
    )

    print(separator)

    for field, values in results.items():
        value1 = fmt(values["Json1"])
        value2 = fmt(values["Json2"])
        difference = fmt(values["Difference"])

        print(
            f"| {field:<{field_width}} "
            f"| {value1:>{value_width}} "
            f"| {value2:>{value_width}} "
            f"| {difference:>{diff_width}} |"
        )

    print(separator)


