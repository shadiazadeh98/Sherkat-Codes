import json


# =====================================================
# Field Mapping
# Position is 1-based
# =====================================================

FIELDS = {

    "Internal Subscriber Reference": (1, 16),

    "NSC Function Code": (17, 4),

    "Trading Date": (21, 8),

    "Instrument ID": (29, 12),


    # Position 42 ثابت می‌ماند
    # فقط Position 43 تا 50 تغییر می‌کند
    "Trade Price": (43, 8),


    "Traded Quantity": (51, 12),

    "Trade Date & time": (63, 14),

    "Order Side": (77, 1),

    "Response Sequence Number Time": (88, 6),

    "Trade Number": (100, 7),

    "Client Account Number": (126, 16),

    "Trader Order Number (TON)": (142, 8),

    "Order Entry Date & time": (150, 14),
}



def json_to_string(data: dict, original_string: str) -> str:

    # مهم:
    # روی همان رشته اصلی کار می‌کنیم
    chars = list(original_string)


    for field, (position, length) in FIELDS.items():

        # اگر Field در JSON نبود:
        # هیچ تغییری نده
        if field not in data:
            continue


        value = str(data[field])


        # Fixed Length
        value = value[:length].ljust(length)


        start = position - 1


        # فقط همان قسمت جایگزین می‌شود
        chars[start:start + length] = list(value)


    return "".join(chars)



