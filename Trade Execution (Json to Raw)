def json_to_execution_notice(json_input) -> str:
    """
    Accept either:
        - JSON string
        - Python dictionary

    and return fixed-width 0105 message.
    """

    if isinstance(json_input, str):

        data = json.loads(json_input)

    elif isinstance(json_input, dict):

        data = json_input

    else:

        raise TypeError(
            "Input must be either a JSON string "
            "or a Python dictionary."
        )

    return dict_to_execution_notice(data)


