def put_raw(
    buffer: list,
    offset: int,
    length: int,
    value,
    field_name: str
):
    """
    Write a value into its fixed-width position.

    IMPORTANT:
    - Existing spaces are preserved.
    - No strip/rstrip/lstrip is performed.
    - If the supplied value is shorter than the field length,
      missing characters are filled with spaces on the RIGHT.
    - If it is longer than the field length, an error is raised.
    """

    if value is None:
        value = ""

    value = str(value)

    if len(value) > length:
        raise ValueError(
            f"{field_name}: invalid length. "
            f"Maximum={length}, "
            f"Actual={len(value)}, "
            f"Value={value!r}"
        )

    # Preserve existing spaces and add only required
    # padding on the right.
    value = value.ljust(length, " ")

    start = offset - 1
    end = start + length

    buffer[start:end] = list(value)


