import json


FIELDS = {

    "Internal Subscriber Reference": (1, 16),

    "NSC Function Code": (17, 4),

    "Trading Date": (21, 8),

    "Instrument ID": (29, 12),

    # Position 42 ثابت است
    # شروع Trade Price از Position 43
    "Trade Price": (43, 8),

    "Traded Quantity": (51, 12),

    "Trade Date & time": (63, 14),

    "Order Side": (77, 1),

    "Response Sequence Number Time": (88, 6),

    "Trade Number": (100, 7),

    "Client Account Number": (126, 16),

    "Trader Order Number (TON)": (142, 8),

    "Order Entry Date & time": (150, 14),
}



def parse_string_to_json(message: str) -> dict:

    result = {}

    for field, (position, length) in FIELDS.items():

        start = position - 1

        result[field] = message[start:start + length]


    return result



